# 复制为 .env 后自行填写：cp .env.example .env
# .env 已被 git 忽略，切勿将真实值提交到仓库。

# 浏览器登录凭据（建议设置）。
INVEST_AUTH_USER=
INVEST_AUTH_PASS=

# 供其他程序调用 API 的 Bearer Token（建议生成随机值：openssl rand -hex 32）。
INVEST_API_TOKEN=

# 金十金融日历（可选）。仅服务端读取，不会发送到浏览器。
JIN10_MCP_TOKEN=

# 可选：出网代理，留空代表直连。
# INVEST_PROXY_URL=http://127.0.0.1:7890

# 可选，通常无需修改。
# 自动刷新间隔，默认 10 分钟。
# INVEST_REFRESH_INTERVAL_MS=600000
# 单批并发拉取上限，默认 4。
# INVEST_QUOTE_CONCURRENCY=4
# 手动刷新的并发上限，默认 6。
# INVEST_MANUAL_QUOTE_CONCURRENCY=6
# 单个行情请求超时（毫秒），默认 8000。
# INVEST_REQUEST_TIMEOUT_MS=8000
# 登录态有效期（滑动续期），默认 180 天。
# INVEST_SESSION_TTL_MS=15552000000
# 持仓报价缓存，默认 60 秒。
# PORTFOLIO_QUOTE_CACHE_MS=60000
# 汇率缓存，默认 6 小时。
# INVEST_FX_CACHE_MS=21600000
